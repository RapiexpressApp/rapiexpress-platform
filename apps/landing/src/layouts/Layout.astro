---
import '../styles/globals.css';

import { Font } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  // TODO: replace with a purpose-built 1200x630 social card.
  ogImage = '/logo.webp',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Rapiexpress',
  description,
  url: canonicalURL.origin,
  logo: new URL('/logo.webp', Astro.site).href,
  areaServed: ['EC', 'US', 'CN'],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+593-96-398-6148',
      contactType: 'customer service',
      availableLanguage: ['es'],
    },
  ],
  sameAs: [
    'https://www.instagram.com/rapiexpress.ec/',
    'https://www.tiktok.com/@rapiexpress.ec',
    'https://www.facebook.com/profile.php?id=100077301332135',
  ],
};
---

<!doctype html>
<html lang="es" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <Font cssVariable="--font-inter" preload />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rapiexpress" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organizationSchema)}
    />

    {/* Reveal fallback for engines without scroll-driven animations, Firefox
        today. Inline and in the head on purpose: deferred, the class would
        land after first paint and the page would flash visible then hide.
        Every bail-out leaves the markup untouched and fully visible, so the
        failure mode is a static page, never a blank one. */}
    <script is:inline>
      (() => {
        const hasTimelines =
          typeof CSS !== 'undefined' &&
          typeof CSS.supports === 'function' &&
          CSS.supports('animation-timeline', 'view()');
        const stillPreferred = matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (hasTimelines || stillPreferred || !('IntersectionObserver' in window)) return;

        document.documentElement.classList.add('js-reveal');

        addEventListener('DOMContentLoaded', () => {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -10% 0px' },
          );

          const selector = [
            '.section-reveal',
            '.reveal-stagger > *',
            '.draw-on-scroll',
            '.coverage-progress',
            '.coverage-dot',
            '.process-progress',
            '.process-node',
            '.benefits-parcel',
            '.benefits-feed',
            '.benefits-stamp',
          ].join(',');

          for (const el of document.querySelectorAll(selector)) observer.observe(el);
        });
      })();
    </script>
  </head>
  <body class="font-sans antialiased">
    <div
      class="scroll-progress pointer-events-none fixed inset-x-0 top-0 z-[60] h-1 bg-accent-400"
      aria-hidden="true"
    >
    </div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-button focus:bg-accent-400 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-brand-950 focus:ring-2 focus:ring-brand-950 focus:ring-offset-2"
    >
      Saltar al contenido
    </a>

    <slot name="header" />

    <main id="main">
      <slot />
    </main>
  </body>
</html>
