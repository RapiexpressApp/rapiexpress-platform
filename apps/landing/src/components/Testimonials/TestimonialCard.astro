---
export interface Props {
  name: string;
  initials: string;
  city: string;
  rating: number;
  text: string;
}

const { name, initials, city, rating, text } = Astro.props;
---

<figure
  class="section-reveal flex flex-col rounded-card border border-slate-200 bg-white p-6 md:p-8 transition-[transform,box-shadow,border-color] duration-200 ease-out motion-safe:hover:-translate-y-1 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-900/5"
>
  <div class="flex items-center gap-0.5" aria-label={`${rating} de 5 estrellas`}>
    {[1, 2, 3, 4, 5].map((star) => (
      <svg
        class={`h-5 w-5 ${star <= rating ? 'text-accent-400' : 'text-slate-200'}`}
        aria-hidden="true"
        focusable="false"
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
  </div>

  <div class="mt-4 flex items-center gap-1.5 text-sm font-medium text-emerald-600">
    <svg
      class="h-4 w-4"
      aria-hidden="true"
      focusable="false"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2.5"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
    </svg>
    Compra verificada
  </div>

  <blockquote class="mt-5 flex-1 text-base leading-relaxed text-slate-700">
    <span aria-hidden="true" class="text-brand-300">"</span>
    {text}
    <span aria-hidden="true" class="text-brand-300">"</span>
  </blockquote>

  <figcaption class="mt-6 flex items-center gap-3 border-t border-slate-100 pt-5">
    <span
      class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-900 text-sm font-bold text-white"
      aria-hidden="true"
    >
      {initials}
    </span>
    <div>
      <p class="text-sm font-semibold text-brand-950">{name}</p>
      <p class="text-sm text-slate-500">{city}, Ecuador</p>
    </div>
  </figcaption>
</figure>
