---
const navLinks = [
  { label: "Nosotros", href: "#nosotros" },
  { label: "Cómo funciona", href: "#como-funciona" },
  { label: "Beneficios", href: "#beneficios" },
  { label: "Cobertura", href: "#cobertura" },
  { label: "Tiendas", href: "#tiendas" },
  { label: "FAQ", href: "#faq" },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <img src="/logo.webp" alt="Rapiexpress" width="36" height="36" class="w-9 h-9" />
      <span class="text-lg font-bold text-brand-900 tracking-tight hidden sm:inline">Rapiexpress</span>
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden lg:flex items-center gap-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="px-3.5 py-2 text-sm font-medium text-slate-600 hover:text-brand-900 transition-colors duration-150 rounded-md hover:bg-slate-50"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTAs -->
    <div class="flex items-center gap-3">
      <a
        href="#"
        class="hidden sm:inline-flex px-4 py-2 text-sm font-medium text-brand-900 hover:text-brand-700 transition-colors duration-150"
      >
        Iniciar sesión
      </a>
      <a
        href="#"
        class="inline-flex px-4 py-2 bg-accent-400 hover:bg-accent-500 text-brand-950 font-semibold text-sm rounded-lg transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-2"
      >
        Registrarse
      </a>
    </div>
  </div>
</nav>
