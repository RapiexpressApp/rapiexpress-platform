---
import { Image } from 'astro:assets';

import logo from '../assets/logo.webp';

// Section anchors only resolve on the landing. Anywhere else they have to
// carry the path or the link silently does nothing.
const isLanding = Astro.url.pathname === '/';
const anchor = (id: string) => (isLanding ? `#${id}` : `/#${id}`);

const navLinks = [
  { label: 'Cómo funciona', href: '/como-funciona' },
  { label: 'Nosotros', href: anchor('nosotros') },
  { label: 'Beneficios', href: anchor('beneficios') },
  { label: 'Cobertura', href: anchor('cobertura') },
  { label: 'Tiendas', href: anchor('tiendas') },
  { label: 'FAQ', href: anchor('faq') },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-200/60">
  <nav
    aria-label="Principal"
    class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between"
  >
    <a
      href="/"
      class="flex items-center gap-2.5 shrink-0 rounded-button focus-visible:ring-2 focus-visible:ring-brand-900 focus-visible:ring-offset-2"
    >
      <Image
        src={logo}
        alt="Rapiexpress"
        width={36}
        height={36}
        class="w-9 h-9"
        loading="eager"
        fetchpriority="high"
      />
      <span class="text-lg font-bold text-brand-900 tracking-tight hidden sm:inline">Rapiexpress</span>
    </a>

    <ul class="hidden lg:flex items-center gap-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="px-3.5 py-2 text-sm font-medium text-slate-600 hover:text-brand-900 transition-colors duration-150 rounded-md hover:bg-slate-50 focus-visible:ring-2 focus-visible:ring-brand-900 focus-visible:ring-offset-2"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        href={anchor('empieza')}
        class="hidden lg:inline-flex items-center px-4 py-2 text-sm font-semibold text-brand-950 bg-accent-400 rounded-button transition-[background-color,box-shadow,transform] duration-[var(--motion-fast)] ease-entrance hover:bg-accent-300 hover:shadow-md hover:shadow-accent-400/25 motion-safe:hover:-translate-y-px motion-safe:active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-brand-900 focus-visible:ring-offset-2"
      >
        Crea tu casillero gratis
      </a>

      <button
        type="button"
        popovertarget="mobile-nav"
        aria-label="Abrir menú de navegación"
        class="lg:hidden inline-flex h-11 w-11 items-center justify-center -mr-2 rounded-button text-slate-700 hover:bg-slate-100 transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-brand-900 focus-visible:ring-offset-2"
      >
        <svg
          class="w-6 h-6"
          aria-hidden="true"
          focusable="false"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>

  {/* Never add a display utility to [popover]: it overrides the user-agent
      display:none and pins the panel open. lg:hidden is the exception.
      TODO: verify the implicit aria-expanded is announced in VoiceOver. */}
  <div
    id="mobile-nav"
    popover
    class="lg:hidden fixed inset-x-4 top-20 bottom-auto m-0 w-auto max-w-none max-h-[calc(100dvh-6rem)] overflow-y-auto rounded-card border border-slate-200 bg-white p-3 shadow-2xl shadow-black/10"
  >
    <ul class="divide-y divide-slate-100">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            popovertarget="mobile-nav"
            popovertargetaction="hide"
            class="flex items-center min-h-11 px-3 text-base font-medium text-slate-700 hover:text-brand-900 hover:bg-slate-50 rounded-button transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-brand-900 focus-visible:ring-inset"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>
