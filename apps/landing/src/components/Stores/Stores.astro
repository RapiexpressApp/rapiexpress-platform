---
import { Image } from 'astro:assets';

import { stores } from '../../data/stores';
---

<section id="tiendas" aria-labelledby="tiendas-title" class="bg-white">
  <div class="mx-auto max-w-7xl px-6 py-24 md:py-32">
    <div class="section-reveal max-w-2xl">
      <h2 id="tiendas-title" class="text-3xl font-bold tracking-tight text-brand-950 md:text-4xl">
        Compra donde quieras. Nosotros lo traemos.
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-slate-600">
        Tu casillero recibe de cualquier tienda que despache a Miami. Estas son
        las favoritas de nuestros clientes.
      </p>
    </div>

    <ul class="section-reveal mt-14 grid grid-cols-2 gap-4 sm:grid-cols-3 md:mt-16 lg:grid-cols-4">
      {
        stores.map((store) => (
          <li>
            <a
              href={store.href}
              class="group flex min-h-24 items-center justify-center rounded-card border border-slate-200 bg-white p-6 transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md hover:shadow-brand-900/5 focus-visible:ring-2 focus-visible:ring-brand-900 focus-visible:ring-offset-2"
            >
              <Image
                src={store.logo}
                alt={`Comprar en ${store.name}`}
                width={180}
                loading="lazy"
                decoding="async"
                class="h-auto w-full max-w-36"
              />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="section-reveal mt-10 text-lg text-slate-600">
      ¿Otra tienda? También funciona.
      <a
        href="https://wa.me/593963986148"
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 transition-colors duration-150 hover:text-brand-900 hover:decoration-brand-500 focus-visible:ring-2 focus-visible:ring-brand-900 focus-visible:ring-offset-2"
      >
        Escríbenos por WhatsApp
      </a>
      y te confirmamos.
    </p>
  </div>
</section>
