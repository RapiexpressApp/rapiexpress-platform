---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  aria-hidden="true"
  focusable="false"
  fill="none"
  viewBox="0 0 24 120"
  preserveAspectRatio="none"
>
  <path
    class="draw-on-scroll"
    pathLength="1"
    d="M12 2 C 20 30, 4 60, 12 90 C 16 102, 13 112, 12 118"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-dasharray="1"
    vector-effect="non-scaling-stroke"
  />
</svg>
