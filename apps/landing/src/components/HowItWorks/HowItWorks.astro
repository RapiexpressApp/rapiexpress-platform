---
import HowItWorksConnector from './HowItWorksConnector.astro';

interface Step {
  title: string;
  text: string;
}

const steps: Step[] = [
  {
    title: 'Crea tu casillero gratis',
    text: 'Regístrate y recibe al instante tu dirección de casillero en Miami.',
  },
  {
    title: 'Compra en tus tiendas favoritas',
    text: 'Usa tu dirección Miami al pagar en cualquier tienda que despache desde USA o China.',
  },
  {
    title: 'Recíbelo en tu puerta',
    text: 'Rastreamos tu paquete, lo pasamos por aduana y te lo entregamos en Ecuador.',
  },
];
---

<section id="como-funciona" aria-labelledby="como-funciona-title" class="bg-slate-50">
  <div class="mx-auto max-w-7xl px-6 py-24 md:py-32">
    <div class="section-reveal max-w-xl">
      <h2 id="como-funciona-title" class="text-3xl font-bold tracking-tight text-brand-950 md:text-4xl">
        Tres pasos entre tu carrito y tu puerta
      </h2>
    </div>

    <ol class="mt-14 space-y-12 md:mt-16 md:space-y-16">
      {
        steps.map((step, index) => (
          <li class="section-reveal grid gap-4 md:grid-cols-[4.5rem_1fr] md:gap-10">
            <div class="relative flex items-start">
              <span
                class="text-5xl font-bold tabular-nums leading-none tracking-tight text-brand-400 md:text-6xl"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              {index < steps.length - 1 && (
                <HowItWorksConnector class="pointer-events-none absolute left-6 top-20 hidden h-24 w-6 text-brand-300 md:block" />
              )}
            </div>
            <div class="max-w-xl">
              <h3 class="text-xl font-semibold tracking-tight text-brand-950 md:text-2xl">
                {step.title}
              </h3>
              <p class="mt-2 text-lg leading-relaxed text-slate-600">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <a
      href="/como-funciona"
      class="section-reveal group mt-14 inline-flex items-center gap-2 text-lg font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 transition-colors duration-150 hover:text-brand-900 hover:decoration-brand-500 focus-visible:ring-2 focus-visible:ring-brand-900 focus-visible:ring-offset-2 md:mt-16"
    >
      Ver el proceso completo
      <svg
        class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
        aria-hidden="true"
        focusable="false"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </div>
</section>
