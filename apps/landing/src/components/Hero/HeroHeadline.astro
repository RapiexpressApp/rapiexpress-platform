---
import MarkerUnderline from '../MarkerUnderline.astro';
---

<h1
  id="hero-title"
  class="hero-enter text-center lg:text-left text-[clamp(2.5rem,9.5vw,6.5rem)] font-bold uppercase leading-[1.06] tracking-[-0.025em] text-white"
>
  <span class="block uppercase">Ahora, tus compras llegan a&nbsp;ti</span>
  <span class="block uppercase text-accent-400">
      + Rápido
      <span class="relative inline-block">
        + Seguro
        <MarkerUnderline class="doodle-draw pointer-events-none absolute inset-x-0 -bottom-[0.1em] h-[0.1em] w-full text-accent-400" />
      </span>
  </span>
</h1>
