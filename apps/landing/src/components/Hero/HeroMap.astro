    <circle cx="1200" cy="220" r="6" fill="#FACC15" opacity="0.7" />
    <circle cx="1200" cy="220" r="12" fill="#FACC15" opacity="0.15" class="hero-pulse-ring" />
  </g>

  <!-- City labels -->
  <g font-family="Inter, sans-serif" font-size="13" fill="white" opacity="0.5" font-weight="500">
    <text x="460" y="235">Miami, USA</text>
    <text x="460" y="485">Ecuador</text>
    <text x="1220" y="225">China</text>
