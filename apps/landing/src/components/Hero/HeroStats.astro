---
export interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="hero-animate-fade-up hero-delay-5 grid grid-cols-2 gap-x-8 gap-y-4">
  {stats.map((stat, i) => (
    <div class={`${i < 2 ? 'border-b border-white/10 pb-4' : ''}`}>
      <span class="text-2xl md:text-3xl font-bold text-white tabular-nums tracking-tight block">{stat.value}</span>
      <span class="text-xs text-brand-300/60 mt-1 block">{stat.label}</span>
    </div>
  ))}
</div>
