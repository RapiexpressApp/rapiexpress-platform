---
import '../../styles/hero.css';

import Sparkle from '../Sparkle.astro';

import HeroAddress from './HeroAddress.astro';
import HeroHeadline from './HeroHeadline.astro';
import HeroPitch from './HeroPitch.astro';
---

<section aria-labelledby="hero-title" class="relative overflow-hidden bg-brand-900">
  <div
    class="pointer-events-none absolute inset-0 bg-linear-to-b from-brand-950/40 via-transparent to-brand-950/60"
    aria-hidden="true"
  >
  </div>

  <Sparkle class="doodle-float pointer-events-none absolute right-[10%] top-32 h-5 w-5 text-accent-400/60" />
  <Sparkle class="doodle-float-slow pointer-events-none absolute left-[6%] top-[45%] h-4 w-4 text-white/25" />
  <Sparkle class="doodle-float pointer-events-none absolute bottom-24 right-[28%] hidden h-3.5 w-3.5 text-white/20 md:block" />

  <div
    class="relative mx-auto flex min-h-[100svh] lg:min-h-[72svh] max-w-7xl flex-col items-center lg:items-start justify-center px-6 pt-[clamp(5.5rem,18vh,9rem)] pb-[clamp(3.5rem,7vh,5rem)]"
  >
    <HeroHeadline />

    <div
      class="mt-[clamp(2.5rem,9vh,5.5rem)] grid w-full gap-y-10 border-t border-white/12 pt-9 text-center lg:text-left lg:grid-cols-12 lg:items-start lg:gap-x-8"
    >
      <div class="lg:col-span-7"><HeroPitch /></div>
      <div class="lg:col-span-4 lg:col-start-9 lg:pt-1"><HeroAddress /></div>
    </div>
  </div>
</section>
