---
export interface Package {
  store: string;
  tracking: string;
  status: string;
  color: string;
}

interface Props {
  packages: Package[];
}

const { packages } = Astro.props;
---

<!--
  Decorative product illustration built from placeholder data. Hidden from
  assistive technology: announcing "Amazon.com RE-2026-0847" would read as
  real shipment data. It contains no focusable elements, so aria-hidden is
  safe here.
-->
<div class="relative hidden lg:block" aria-hidden="true">
  <div class="hero-animate-scale-in hero-delay-6 relative bg-white rounded-2xl shadow-2xl shadow-black/50 border border-white/10 overflow-hidden hover:shadow-2xl hover:shadow-black/60 transition-shadow duration-300">
    <!-- Mockup header bar -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white">
      <div class="flex items-center gap-3">
        <div class="flex gap-2">
          <div class="w-3 h-3 rounded-full bg-slate-300" />
          <div class="w-3 h-3 rounded-full bg-slate-300" />
          <div class="w-3 h-3 rounded-full bg-slate-300" />
        </div>
        <span class="text-sm font-semibold text-slate-700 ml-2">Rapiexpress Dashboard</span>
      </div>
      <span class="text-xs font-semibold text-slate-500 bg-white px-3 py-1.5 rounded-lg border border-slate-200 shadow-sm">3 paquetes activos</span>
    </div>

    <!-- Package list -->
    <div class="divide-y divide-slate-100">
      {packages.map((pkg, idx) => (
        <div class={`flex items-center justify-between px-6 py-5 hover:bg-slate-50/80 transition-[background-color,transform] duration-150 hover:translate-x-1 ${idx === 0 ? 'bg-accent-50/30' : ''}`}>
          <div class="flex items-center gap-4 min-w-0">
            <div class={`w-3 h-3 rounded-full ${pkg.color} shrink-0 ring-4 ${pkg.color === 'bg-status-bodega' ? 'ring-amber-400/20' : pkg.color === 'bg-status-embarcado' ? 'ring-blue-400/20' : 'ring-indigo-400/20'}`} />
            <div class="min-w-0">
              <p class="text-sm font-semibold text-slate-900 truncate">{pkg.store}</p>
              <p class="text-xs text-slate-500 font-mono mt-1">{pkg.tracking}</p>
            </div>
          </div>
          <div class="flex items-center gap-3 ml-4">
            <span class="text-sm text-slate-600 whitespace-nowrap font-medium">{pkg.status}</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      ))}
    </div>

    <!-- Mockup footer -->
    <div class="flex items-center justify-between px-6 py-4 bg-gradient-to-r from-brand-50/80 to-brand-100/50 border-t border-brand-100">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-brand-100 flex items-center justify-center">
          <svg class="w-4 h-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
        </div>
        <div>
          <p class="text-xs text-brand-600 font-medium">Ruta de envío</p>
          <p class="text-sm font-bold text-brand-900">Miami → Guayaquil</p>
        </div>
      </div>
      <div class="text-right">
        <p class="text-xs text-slate-500">Tiempo estimado</p>
        <p class="text-lg font-bold text-accent-600 tabular-nums">7–12 días</p>
      </div>
    </div>
  </div>

  <!-- Floating stat card -->
  <div class="hero-animate-fade-up hero-delay-6 absolute -bottom-8 -left-8 bg-white rounded-2xl shadow-2xl shadow-black/20 border border-slate-100 p-5 w-64 hover:shadow-2xl hover:shadow-black/30 hover:-translate-y-1 transition-[box-shadow,transform] duration-200">
    <div class="flex items-start gap-4 mb-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-accent-400 to-accent-500 flex items-center justify-center shadow-lg shadow-accent-400/30">
        <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
        </svg>
      </div>
      <div>
        <p class="text-xs text-slate-500 font-medium">Entrega promedio</p>
        <p class="text-2xl font-bold text-slate-900 tabular-nums mt-0.5">7-12 días</p>
      </div>
    </div>
    <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden">
      <div class="h-full w-[78%] bg-gradient-to-r from-accent-400 to-accent-500 rounded-full" />
    </div>
    <p class="text-xs text-slate-500 mt-2">98% de entregas a tiempo</p>
  </div>
</div>
