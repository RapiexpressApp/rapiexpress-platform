---
const included: string[] = [
  'Apertura del casillero, sin suscripción',
  'Consolidación de varias compras en un solo envío',
  'Reempaque para reducir volumen',
  'Seguro desde que llega a Miami hasta la entrega',
  'Avisos por WhatsApp en cada cambio de estado',
];
---

<section aria-labelledby="incluye-title" class="bg-slate-50">
  <div class="mx-auto max-w-7xl px-6 py-24 md:py-28">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="section-reveal lg:col-span-6">
        <h2
          id="incluye-title"
          class="text-3xl font-bold tracking-tight text-brand-950 md:text-4xl"
        >
          Qué está incluido
        </h2>

        <ul class="mt-8 space-y-4">
          {
            included.map((item) => (
              <li class="flex gap-4 text-lg leading-relaxed text-slate-700">
                <svg
                  class="mt-1.5 h-5 w-5 shrink-0 text-brand-600"
                  aria-hidden="true"
                  focusable="false"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="section-reveal lg:col-span-5 lg:col-start-8">
        <h3 class="text-2xl font-bold tracking-tight text-brand-950">
          Cómo se calcula el costo
        </h3>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          Por el peso y el volumen de tu paquete. Un bulto liviano pero grande
          ocupa espacio en el avión, y eso también cuenta.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">
          Conoces el valor antes de que salga de Miami. Sin cargos que aparezcan
          en la factura final.
        </p>

        <div class="mt-8 rounded-card border border-slate-200 bg-white p-6">
          <p class="font-semibold text-brand-950">¿Necesitas una cotización?</p>
          <p class="mt-2 leading-relaxed text-slate-600">
            Escríbenos con el peso aproximado y la tienda, y te confirmamos el
            costo antes de que compres.
          </p>
          <a
            href="https://wa.me/593963986148"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-2 font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 transition-colors duration-150 hover:text-brand-900 hover:decoration-brand-500 focus-visible:ring-2 focus-visible:ring-brand-900 focus-visible:ring-offset-2"
          >
            Escríbenos por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
