{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	handle /_astro/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
